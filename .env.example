# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
# ── Nobody sends anybody their .env file ──────────────────────────────────────────────────
#
# Every value below is one you generate for yourself in about a minute, and none of them is
# shared between developers. That is not caution for its own sake — it is what these
# variables actually are:
#
#   · SESSION_SECRET signs the cookie in *your* browser. Somebody else's is no more use to
#     you than their house key.
#   · DEV_USER_EMAIL / DEV_USER_PASSWORD are compared against these variables and nothing
#     else — there is no user table yet. You are choosing your own sign-in, not being issued
#     one.
#   · DATABASE_URL points at the Postgres container on your own machine.
#
# What must never be copied between machines is the pair that grants access to something
# real: the **Blob token** for the client document store, and anything out of a production
# environment. Neither is here and neither is needed, because local development writes
# documents to local disk. `USE_BLOB_STORAGE=1` opts in, and only the person who set that
# store up should ever hold its token.
#
# If a credential does end up in a chat window, an email or a screenshot, treat it as
# compromised and rotate it rather than hoping.

# Signs the session cookie. 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The environment credential – how you sign in locally, and the operator's break-glass login
# elsewhere. Under a production build (Vercel, preview included, or the container) it is refused
# unless OPERATOR_LOGIN=1 is also set, so a deployment does not carry a working password in its
# settings by default (ARC-003). Set OPERATOR_LOGIN=1 only for the repair that needs it, then
# remove it – removing it also ends every operator session.
DEV_USER_EMAIL=
DEV_USER_PASSWORD=
# OPERATOR_LOGIN=1
# The name this credential signs off under — "Signed off by Thandi Nkosi". People added under
# Settings → People carry their own names; this credential has no row, so it takes its name here.
# Left empty, its sign-offs show the email.
DEV_USER_NAME=

# Postgres 16. Any host works — nothing in the schema is host-specific, so this is
# the only thing that changes between local, Neon, RDS or Render.
#
#   docker run -d --name qs-platform-db -p 5434:5432 \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=qs_platform postgres:16-alpine
DATABASE_URL=postgresql://postgres:devpassword@localhost:5434/qs_platform?sslmode=disable

# ── Optional, and genuinely optional ─────────────────────────────────────────────────────
#
# The gate needs none of this. No suite in `checks/` reads a model key, and
# the application only looks for one at the moment it would call the model — `/api/health`
# reports "no key" rather than failing. So you can develop, run the whole gate and open a
# pull request without ever having one.
#
# You need a key only to run an agent for real, and then it should be **your own**, on your
# own account: a second key can be revoked without breaking anybody else's work, and a
# shared one cannot. The entire live suite costs about $0.002, so the smallest top-up lasts
# a very long time. platform.deepseek.com.
DEEPSEEK_API_KEY=

# The stronger model, for work with legal or cost consequences: evaluating quotations and tenders,
# measuring take-offs, building up rates (the "consequential" purposes in src/lib/egress/policy.ts).
# Generic reading stays on DeepSeek. Without this key, development falls back to DeepSeek so you can
# work without it; production does not – those tasks refuse until it is set. console.anthropic.com.
ANTHROPIC_API_KEY=

# ── What may leave the platform (ARC-005) ─────────────────────────────────────────────────
#
# Every call to an AI model, the web search and the email provider goes through the egress gateway
# (src/lib/egress). In production it sends NOTHING to a vendor until the practice has recorded its
# legal basis for that transfer (POPIA s72; GDPR Chapter V where EU data subjects are involved).
# The value is the reference a regulator would ask for, e.g.
#   EGRESS_BASIS_DEEPSEEK="s72(1)(a) operator agreement with DeepSeek, signed 2026-11-20, ref LEGAL-014"
# Unset in production = refused, with the reason shown to the reader and written to the ledger.
# Unset in development = "development – no client data". Leave these empty locally.
EGRESS_BASIS_DEEPSEEK=
EGRESS_BASIS_ANTHROPIC=
EGRESS_BASIS_RESEND=

# What a run cost, in dollars per million tokens, so the run's footer can price it. Absent,
# the platform reports the cost as unpriced rather than showing $0.0000 over a run that did
# spend something — see `costOf` in src/lib/agent/deepseek.ts.
LLM_USD_PER_MTOK_IN=
LLM_USD_PER_MTOK_OUT=
